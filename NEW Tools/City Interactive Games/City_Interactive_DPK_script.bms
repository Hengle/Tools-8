# Script by Bartlomiej Duda (Ikskoks)
# City Interactive / CI Games DPK script


# Ver    Date        Author               Comment
# v0.1   25.06.2023  Bartlomiej Duda      -
# v1.0   14.06.2026  Bartlomiej Duda      -


idstring "DPK4"
comtype zlib
get ARCHIVE_SIZE long
get DIRECTORY_SIZE long
get NUMBER_OF_FILES long


for i = 0 < NUMBER_OF_FILES
	get ENTRY_LENGTH long
	get UNCOMPRESSED_FILE_SIZE long
	get COMPRESSED_FILE_SIZE long
	get FILE_OFFSET long
	get FILE_PATH string
	Padding 4
	if UNCOMPRESSED_FILE_SIZE == COMPRESSED_FILE_SIZE
		log FILE_PATH FILE_OFFSET UNCOMPRESSED_FILE_SIZE
	else
		clog FILE_PATH FILE_OFFSET COMPRESSED_FILE_SIZE UNCOMPRESSED_FILE_SIZE
	endif
next i
